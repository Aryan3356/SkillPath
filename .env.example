MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillpath
# Optional comma-separated DNS servers for networks that block Atlas SRV lookups.
MONGODB_DNS_SERVERS=
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GEMINI_API_KEY=
NEXT_PUBLIC_AUTH_ENABLED=false

